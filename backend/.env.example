# ServiceFinanceAnt API — environment configuration
# Copy to .env and adjust per environment (development / staging / production).
NODE_ENV=development
PORT=4000

# PostgreSQL (local Docker in dev; Amazon RDS PostgreSQL in staging/production —
# in AWS, load this from Secrets Manager, never from a committed file)
DATABASE_URL=postgres://sfa:sfa_dev_password@localhost:5433/servicefinance

# Auth
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Object storage (Wasabi in staging/production; MinIO locally).
# Wasabi example: STORAGE_ENDPOINT=https://s3.us-east-1.wasabisys.com
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=servicefinance-files
STORAGE_ACCESS_KEY=sfa-storage-key
STORAGE_SECRET_KEY=sfa-storage-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_URL_TTL=300

# Payments (mock provider locally; set PAYMENT_PROVIDER=north for real card-on-file
# charges via North's Recurring Billing API — requires NORTH_MID, NORTH_DEVELOPER_KEY,
# NORTH_PASSWORD, NORTH_APPSOURCE and NORTH_SIGNATURE_SECRET below)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=mock-secret

# North / Payanywhere billing (sandbox or production)
# Required for North gateway calls:
NORTH_MID=
NORTH_DEVELOPER_KEY=
NORTH_PASSWORD=
NORTH_APPSOURCE=
NORTH_SIGNATURE_SECRET=
# Optional override URLs (defaults shown in config):
# NORTH_FUNCTIONS_BASE_URL=https://proxy.payanywhere.com
# NORTH_BILLING_BASE_URL=https://billing.epxuap.com

# North Embedded Checkout (recommended for agreement payment capture)
NORTH_EMBEDDED_CHECKOUT_ID=
NORTH_EMBEDDED_PROFILE_ID=
NORTH_EMBEDDED_PRIVATE_API_KEY=
# Optional override URL (default shown in config):
# NORTH_EMBEDDED_BASE_URL=https://checkout.north.com
# Webhook signing secret from Embedded Checkout API Keys (sec_...)
NORTH_WEBHOOK_SECRET=

# Outbound email (mock logs only, SES sends real email)
# For SES in production set:
# EMAIL_PROVIDER=ses
# EMAIL_FROM=service@yourdomain.com (must be SES-verified)
# EMAIL_REPLY_TO=support@yourdomain.com
# EMAIL_SES_REGION=us-east-1
# Optional if not using IAM role-based credentials:
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=mock
EMAIL_FROM=service@boxersolutionspestcontrol.com
EMAIL_REPLY_TO=service@boxersolutionspestcontrol.com
EMAIL_SES_REGION=us-east-1
EMAIL_SES_ACCESS_KEY_ID=
EMAIL_SES_SECRET_ACCESS_KEY=

# Maps / route optimization provider
ROUTE_OPTIMIZER=nearest-neighbor
MAPS_API_KEY=

# Optional: Cognito-backed customer portal OTP (EMAIL_OTP via USER_AUTH flow).
# Requires a user pool app client configured for email OTP challenge.
COGNITO_EMPLOYEE_AUTH_ENABLED=false
COGNITO_CUSTOMER_OTP_ENABLED=false
COGNITO_AUTO_CREATE_CUSTOMER_USERS=true
COGNITO_AUTO_CREATE_EMPLOYEE_USERS=true
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_USER_POOL_CLIENT_SECRET=

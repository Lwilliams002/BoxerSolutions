# ServiceFinanceAnt API — environment configuration
# Copy to .env and adjust per environment (development / staging / production).
NODE_ENV=development
PORT=4000

# PostgreSQL (local Docker in dev; Amazon RDS PostgreSQL in staging/production —
# in AWS, load this from Secrets Manager, never from a committed file)
DATABASE_URL=postgres://sfa:sfa_dev_password@localhost:5433/servicefinance

# Auth
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Object storage (Wasabi in staging/production; MinIO locally).
# Wasabi example: STORAGE_ENDPOINT=https://s3.us-east-1.wasabisys.com
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=servicefinance-files
STORAGE_ACCESS_KEY=sfa-storage-key
STORAGE_SECRET_KEY=sfa-storage-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_URL_TTL=300

# Payments (mock provider locally; swap PAYMENT_PROVIDER=stripe later)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=mock-secret

# Maps / route optimization provider
ROUTE_OPTIMIZER=nearest-neighbor
MAPS_API_KEY=

# Optional: Cognito-backed customer portal OTP (EMAIL_OTP via USER_AUTH flow).
# Requires a user pool app client configured for email OTP challenge.
COGNITO_EMPLOYEE_AUTH_ENABLED=false
COGNITO_CUSTOMER_OTP_ENABLED=false
COGNITO_AUTO_CREATE_CUSTOMER_USERS=true
COGNITO_AUTO_CREATE_EMPLOYEE_USERS=true
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_USER_POOL_CLIENT_SECRET=

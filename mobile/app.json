{
  "expo": {
    "name": "AntServe",
    "slug": "antserve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.antserve.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to show your position on the route map.",
        "NSCameraUsageDescription": "Used to take service photos.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to appointments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.antserve.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow AntServe to take service photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your position on the route map."
        }
      ]
    ],
    "scheme": "antserve"
  }
}
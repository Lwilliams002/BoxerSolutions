{
  "expo": {
    "name": "Boxer Solutions Pest Control",
    "slug": "boxer-solutions",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boxersolutionspestcontrol.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to show your position on the route map.",
        "NSCameraUsageDescription": "Used to take service photos.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to appointments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.boxersolutionspestcontrol.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Boxer Solutions Pest Control to take service photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your position on the route map."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "boxersolutionspestcontrol",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "246c70b3-caa1-463c-a662-60f89485435c"
      }
    }
  }
}

{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.boxersolutionspestcontrol.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.boxersolutionspestcontrol.com"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_USE_FRAMEWORKS": "static",
        "EXPO_PUBLIC_API_URL": "https://api.boxersolutionspestcontrol.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
